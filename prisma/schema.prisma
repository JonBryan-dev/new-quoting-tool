generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String
  category    String   // boiler, solar, aircon, battery, heatpump, ev-charger
  type        String   // combi, system, regular, panel, split, etc.
  description String
  imageUrl    String?
  basePrice   Float
  efficiency  String?  // e.g., "94%", "A++"
  warranty    Int      // years
  kw          Float?   // power output
  features    String[] // array of feature strings
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes      Quote[]
}

model Quote {
  id              String   @id @default(cuid())
  category        String
  fuelType        String?
  currentType     String?
  isWorking       Boolean?
  relocate        Boolean?
  propertyType    String?
  bedrooms        Int?
  bathrooms       Int?
  postcode        String?
  email           String?
  phone           String?
  name            String?
  totalPrice      Float?
  installPrice    Float?
  status          String   @default("pending") // pending, accepted, completed
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PricingRule {
  id          String   @id @default(cuid())
  category    String
  ruleType    String   // base_install, relocation, complexity, property_modifier
  condition   String   // JSON string of conditions
  adjustment  Float    // price adjustment (positive or negative)
  isPercent   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SurveyBooking {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  addressLine   String?
  postcode      String
  preferredDate String?  // ISO date string chosen by the customer
  timeSlot      String?  // am, pm, either
  notes         String?
  source        String?  // estimate, boiler-results, homepage, direct
  productId     String?
  productName   String?
  quotedPrice   Float?
  priceBeforeGrant Float?
  propertyType  String?
  bedrooms      Int?
  bathrooms     Int?
  status        String   @default("new") // new, contacted, booked, surveyed, quoted, won, lost
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // bcrypt hash
  createdAt DateTime @default(now())
}

// ── SEO Command Centre ─────────────────────────────────────

model SeoKeyword {
  id         String         @id @default(cuid())
  phrase     String
  targetPath String? // page this keyword should rank for, e.g. /heat-pumps/stafford
  notes      String?
  createdAt  DateTime       @default(now())
  checks     SeoRankCheck[]
}

model SeoRankCheck {
  id        String     @id @default(cuid())
  keywordId String
  keyword   SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  position  Int? // Google position; null = not found in top 100
  source    String     @default("manual") // manual, gsc
  checkedAt DateTime   @default(now())
}

model SeoTask {
  id          String    @id @default(cuid())
  title       String
  category    String // weekly, content, backlinks, gbp, technical
  frequency   String? // weekly, monthly, once
  status      String    @default("open") // open, done
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model SeoSnapshot {
  id              String   @id @default(cuid())
  weekStart       DateTime @unique // Monday of the captured week
  sessions        Int      @default(0)
  activeUsers     Int      @default(0)
  leads           Int      @default(0)
  gscClicks       Int      @default(0)
  gscImpressions  Int      @default(0)
  gscQueries      Int      @default(0)
  avgPosition     Float?
  top10Count      Int      @default(0)
  trackedKeywords Int      @default(0)
  tasksDone       Int      @default(0)
  tasksOpen       Int      @default(0)
  createdAt       DateTime @default(now())
}

model SeoDraft {
  id         String   @id @default(cuid())
  kind       String // meta, article, improve, keywords, gbp-post, custom
  targetPath String?
  brief      String
  content    String
  model      String?
  status     String   @default("draft") // draft, approved, published
  createdAt  DateTime @default(now())
}
